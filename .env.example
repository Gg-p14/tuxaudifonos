# Copia este archivo a .env (o define las variables en tu terminal). Nunca subas .env a Git.
DB_SERVER=localhost
DB_NAME=tuxaudifonos_db
DB_DRIVER=ODBC Driver 18 for SQL Server
# Autenticación SQL (déjalas vacías para usar autenticación de Windows)
DB_USER=
DB_PASSWORD=
DB_TRUST_CERTIFICATE=yes
# Opcional: crea un administrador inicial si aún no existe.
INITIAL_ADMIN_EMAIL=admin@tuxaudifonos.local
INITIAL_ADMIN_PASSWORD=
# Obligatoria en producción. Genera una con: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Pon 1 cuando sirvas la tienda con HTTPS
HTTPS_ONLY=0

